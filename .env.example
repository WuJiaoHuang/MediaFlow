# Copy to .env (ignored). Never commit real credentials or signing keys.
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password
DB_URL=jdbc:mysql://localhost:3306/mediaflow?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# Generate a random 48-byte or longer secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-generated-random-secret-at-least-32-bytes
SERVER_PORT=8080
TOKEN_TTL_SECONDS=1800
